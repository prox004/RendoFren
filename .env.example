# ==========================================
# RendoFren Environment Configuration Example
# ==========================================

# --- Server Configuration ---
PORT=5000
NODE_ENV=development

# --- IPFS / Pinata (Storage Layer) ---
# Used for storing encrypted project files and rendered frames
PINATA_API_KEY=""
PINATA_API_SECRET=""
PINATA_JWT=""

# --- Upstash Redis (BullMQ / Job Queue) ---
# Used for job orchestration and task distribution
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# --- Blockchain Configuration ---
# RPC URL for the network where the escrow contract is deployed
BASE_RPC_URL=""
NETWORK_CHAIN_ID=84532 # Base Sepolia
# The deployed address of RendoFrenEscrow.sol
ESCROW_CONTRACT_ADDRESS=""

# --- Encryption & Security ---
# Master key used for AES-256 encryption. Keep this secure!
# Generate a strong 32-character string for production.
MASTER_ENCRYPTION_KEY="your_secure_random_32_char_key_here"

# --- Pricing & Economics ---
# Default price per frame in ETH (or native chain token)
PRICE_PER_FRAME_ETH=0.0001

